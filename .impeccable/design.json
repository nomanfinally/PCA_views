      "description": "Sage pressed state preserves named plot actions.",
      "html": "<button class=\"ds-tool\" aria-pressed=\"true\">Pan</button>",
      "css": ".ds-tool{font-family:var(--font-family-sans, sans-serif);min-height:36px;padding:7px 11px;border:1px solid transparent;border-radius:6px;background:#fff;color:var(--color-text-primary,#24392c);font-size:13px;font-weight:500;cursor:pointer}.ds-tool:hover{background:var(--color-surface-100,#e9f0e9)}.ds-tool[aria-pressed=\"true\"]{background:#e0eee6;color:#19563a;border-color:#b9d1c2}.ds-tool:focus-visible{outline:2px solid var(--color-accent,#235b3e);outline-offset:3px}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "White field with strong border and forest focus.",
      "html": "<input class=\"ds-field\" aria-label=\"Find sample or population\" placeholder=\"Find sample or population\u2026\">",
      "css": ".ds-field{font-family:var(--font-family-sans, sans-serif);min-height:36px;padding:6px 9px;border:1px solid var(--color-border-strong,#afbeb1);border-radius:5px;background:#fff;color:var(--color-text-primary,#24392c);font-size:14px;accent-color:var(--color-accent,#235b3e);caret-color:var(--color-accent,#235b3e)}.ds-field::placeholder{color:var(--color-text-muted,#5c6e60);opacity:1}.ds-field:focus-visible{outline:2px solid var(--color-accent,#235b3e);outline-offset:3px}"
    },
    {
      "name": "Settings navigation",
      "kind": "nav",
      "refersTo": "navigation-settings",
      "description": "Desktop section rail; runtime supplies roving focus and activation.",
      "html": "<div class=\"ds-settings\" role=\"tablist\" aria-label=\"Settings sections\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Chart</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Markers</button></div>",
      "css": ".ds-settings{width:156px;padding:12px;display:flex;flex-direction:column;gap:4px;border-right:1px solid var(--color-border,#d6e0d7);background:var(--color-surface-50,#f4f7f3)}.ds-tab{font-family:var(--font-family-sans, sans-serif);display:block;width:100%;min-height:38px;padding:9px 12px;text-align:left;border:0;background:transparent;color:#555;font-size:13px;cursor:pointer}.ds-tab:hover{background:#f0f0f0}.ds-tab[aria-selected=\"true\"]{background:#dcebdc;color:#245639;border-radius:5px;font-weight:600}.ds-tab:focus-visible{outline:2px solid var(--color-accent,#235b3e);outline-offset:3px}"
    },
    {
      "name": "Example badge",
      "kind": "chip",
      "refersTo": "badge-example",
      "description": "Informational badge identifies synthetic data; not a filter.",
      "html": "<div class=\"ds-badge-context\"><span class=\"ds-example\">EXAMPLE</span></div>",
      "css": ".ds-badge-context{padding:12px;background:#153f30}.ds-example{font-family:var(--font-family-sans, sans-serif);display:inline-block;padding:3px 6px;border:1px solid #719780;border-radius:3px;color:#e0f3e7;font-size:10px;font-weight:650}"
    },
    {
      "name": "Upload target",
      "kind": "card",
      "refersTo": "card-upload",
      "description": "Dashed sage container for a local file action.",
      "html": "<div class=\"ds-upload\"><strong>Open your PCA results</strong><span>Choose a smartPCA .evec file</span><button class=\"ds-upload-action\">Open .evec</button></div>",
      "css": ".ds-upload{font-family:var(--font-family-sans, sans-serif);display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:28px;background:#edf3e9;border:1px dashed #8fa58f;border-radius:10px;color:var(--color-text-primary,#24392c)}.ds-upload>span{font-size:12px;color:#52664f}.ds-upload-action{font-family:var(--font-family-sans, sans-serif);min-height:42px;padding:10px 18px;background:#1f2328;color:#fff;border:1px solid #1f2328;border-radius:3px;font-size:11px;font-weight:550;cursor:pointer}.ds-upload-action:hover{background:#374151;border-color:#374151}.ds-upload-action:active{background:#111827}.ds-upload-action:focus-visible{outline:2px solid var(--color-accent,#235b3e);outline-offset:3px}"
    },
    {
      "name": "Population row",
      "kind": "custom",
      "refersTo": "population-row",
      "description": "Data marker, group name, and tabular count remain legible together.",
      "html": "<div class=\"ds-population\"><button class=\"ds-population-name\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"6\" r=\"4\" fill=\"#1f77b4\" stroke=\"#174d73\" stroke-width=\".5\"/></svg><span>Group_A</span><span class=\"ds-count\">60</span></button><button class=\"ds-more\" aria-label=\"Edit Group_A\">\u2026</button></div>",
      "css": ".ds-population{font-family:var(--font-family-sans, sans-serif);display:flex;align-items:center;border-radius:5px;background:var(--color-surface-50,#f4f7f3);color:#233e2e}.ds-population:hover{background:#e4eee2}.ds-population-name{font-family:var(--font-family-sans, sans-serif);display:flex;align-items:center;gap:9px;flex:1;min-width:0;min-height:38px;padding:8px;border:0;border-radius:5px;background:transparent;color:inherit;font-size:13px;text-align:left;cursor:pointer}.ds-count{margin-left:auto;color:#5c6f62;font-size:12px;font-variant-numeric:tabular-nums}.ds-more{width:30px;height:30px;min-height:30px;background:transparent;border:0;border-radius:5px;color:inherit;cursor:pointer}.ds-population-name:focus-visible{outline:2px solid var(--color-accent,#235b3e);outline-offset:3px}.ds-more:focus-visible{outline:2px solid var(--color-accent,#235b3e);outline-offset:3px}"
    },
    {
      "name": "Sample inspector",
      "kind": "custom",
      "refersTo": "inspector",
      "description": "White floating sample details with bounded width and numeric alignment.",
      "html": "<section class=\"ds-inspector\" aria-label=\"Sample inspector\"><strong>Sample_014</strong><p>Group_A</p><div class=\"ds-coordinate\"><span>PC1</span><span>0.031582</span></div><div class=\"ds-coordinate\"><span>PC2</span><span>\u22120.012948</span></div></section>",
      "css": ".ds-inspector{font-family:var(--font-family-sans, sans-serif);width:300px;max-width:calc(100vw - 16px);padding:14px;border:1px solid #b8c7b8;border-radius:8px;background:#fff;color:var(--color-text-primary,#24392c);box-shadow:0 14px 32px #193c282b;font-size:13px}.ds-inspector>p{font-size:10px;color:#696969}.ds-coordinate{display:flex;justify-content:space-between;gap:10px;padding:6px 0;font-size:12px;font-variant-numeric:tabular-nums}"
    }
  ],
  "narrative": {
    "northStar": "The Research Atlas",
    "overview": "A quiet scientific working surface: forest green frames white plotting paper, with pale sage margins for tools and population information. Fine borders, compact controls, and explicit labels give the data the strongest visual presence. The botanical reference lives in the palette and margin structure; the interface uses familiar web controls and no ornamental imagery.\n\nThe interface supports deliberate inspection and figure preparation. Scientific colors belong to samples and populations; interface colors communicate actions and state. System sans typography serves the operating interface, with aligned numeric data and compact monospace editors. No raster assets or approved image composition are part of this system.",
    "keyCharacteristics": [
      "White plotting paper and sage supporting surfaces.",
      "Forest framing, restrained lime export emphasis, and fine structural rules.",
      "Compact named actions; desktop Appearance disclosure and horizontal tool scrolling on phones and short landscape screens.",
      "Scientific color and row identity preserved across inspection and export."
    ],
    "rules": [
      {
        "name": "The Encoding Rule",
        "body": "Keep UI state colors separate from scientific palette assignments; show names, counts, visibility text, and selection/focus treatments alongside color.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Use tabular figures for aligned measurements and counts, preserve meaningful coordinate precision, and keep identifiers readable without changing their underlying values.",
        "section": "typography"
      },
      {
        "name": "The Chart Space Rule",
        "body": "On phones and short landscape screens, preserve chart height with native horizontal scrolling for header actions, axes/search, and every plot tool. Keep these rows unwrapped and advanced tools inline, with 44px action targets and accessible names.",
        "section": "layout"
      },
      {
        "name": "The Floating Layer Rule",
        "body": "Reserve shadows for content floating above the working surface, and preserve keyboard focus and dismissal order when adding a layer.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** extend the white chart, sage support surfaces, forest framing, and fine-rule hierarchy using effective source tokens.",
      "**Do** keep data markers, identifiers, counts, edit state, visibility, selection, and exclusion understandable together.",
      "**Do** verify focus, keyboard navigation, nested Escape, viewport clamping, and trigger restoration when extending dialogs or palettes.",
      "**Do** preserve browser-only data processing and offline archive functionality when adding visual features.",
      "**Do** inspect mobile portrait and landscape alongside desktop, especially palette, dock, settings, and export overflow."
    ],
    "donts": [
      "**Don't** reuse a scientific population color as the only signal for an interface action or state.",
      "**Don't** introduce ornamental raster assets, decorative chart cards, or unrelated typography into the implemented atlas world.",
      "**Don't** copy superseded gray tokens, tiny legacy helper text, or numeric-editor blue focus as a new default design rule.",
      "**Don't** alter scientific values or row identity to simplify the display, or conflate hidden, selected, marked, and excluded samples.",
      "**Don't** describe passing focused checks as whole-app WCAG certification. The [finish verdict](.impeccable/review/finish-verdict.md) resolves its three-item fix list; it does not establish global conformance."
    ]
  }
}
