  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Restored compact primary action, with white text through hover and active.",
      "html": "<button class=\"ds-primary\">Open .evec</button>",
      "css": ".ds-primary{font-family:Arial,Helvetica,sans-serif;height:29px;padding:0 12px;border:1px solid var(--accent,#222222);border-radius:3px;background:var(--accent,#222222);color:#fff;font-size:11px;font-weight:550;cursor:pointer;transition:background-color .15s ease,border-color .15s ease,box-shadow .15s ease}.ds-primary:hover:not(:disabled){background:#374151;border-color:#374151;box-shadow:0 1px 3px rgba(0,0,0,.2)}.ds-primary:active:not(:disabled){background:#111827;border-color:#111827}.ds-primary:focus-visible{outline:2px solid var(--color-border-focus,#777777);outline-offset:2px}.ds-primary:disabled{opacity:.4;cursor:not-allowed}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Compact bordered action used in the restored chrome.",
      "html": "<button class=\"ds-secondary\">Reset styles</button>",
      "css": ".ds-secondary{font-family:Arial,Helvetica,sans-serif;height:29px;padding:0 10px;border:1px solid #d0d7de;border-radius:3px;background:#fff;color:#1f2328;font-size:11px;font-weight:500;cursor:pointer;transition:background-color .15s ease,border-color .15s ease,color .15s ease}.ds-secondary:hover:not(:disabled){background:#f0f2f5;border-color:#cbd5e1;color:#111827}.ds-secondary:active:not(:disabled){background:#e2e8f0;color:#0f172a}.ds-secondary:focus-visible{outline:2px solid var(--color-border-focus,#777777);outline-offset:2px}.ds-secondary:disabled{opacity:.4;cursor:not-allowed}"
    },
    {
      "name": "Plot tool",
      "kind": "button",
      "refersTo": "button-toolbar",
      "description": "Direct desktop tool; the compact layout reduces it to 24px and scrolls the tool row.",
      "html": "<button class=\"ds-tool\" aria-label=\"Zoom in\" aria-pressed=\"false\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-tool{display:inline-flex;align-items:center;justify-content:center;width:29px;height:29px;padding:0;border:0;border-radius:3px;background:transparent;color:#696969;cursor:pointer}.ds-tool:hover:not(:disabled){background:#f2f2f2;color:#4e4e4e}.ds-tool[aria-pressed=\"true\"],.ds-tool:active:not(:disabled){background:#e8e8e8;color:#111}.ds-tool:focus-visible{outline:2px solid var(--color-border-focus,#777777);outline-offset:2px}.ds-tool:disabled{opacity:.4;cursor:not-allowed}@media(max-width:1024px){.ds-tool{width:24px;height:24px}}"
    },
    {
      "name": "Axis field",
      "kind": "input",
      "refersTo": "input",
      "description": "White compact native PC selector; runtime supplies the loaded axes and variance labels.",
      "html": "<label class=\"ds-axis\"><span class=\"ds-axis-label\">X</span><select class=\"ds-axis-select\" aria-label=\"X axis\"><option>PC1 (40.4%)</option><option>PC2 (28.0%)</option></select></label>",
      "css": ".ds-axis{font-family:Arial,Helvetica,sans-serif;display:inline-flex;align-items:center;gap:4px}.ds-axis-label{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border:1px solid #d0d7de;border-radius:3px;background:#f0f0f0;color:#555;font-size:10px;font-weight:600}.ds-axis-select{font-family:Arial,Helvetica,sans-serif;height:27px;min-width:68px;padding:0 6px;border:1px solid #d0d7de;border-radius:3px;background:#fff;color:var(--color-text-primary,#363636);font-size:11px;font-weight:500;cursor:pointer;transition:all .15s ease}.ds-axis-select:hover{background:#f7f7f7;border-color:#999}.ds-axis-select:focus{border-color:#555}.ds-axis-select:focus-visible{outline:2px solid var(--color-border-focus,#777777);outline-offset:2px}@media(max-width:1024px){.ds-axis-select{height:24px;min-width:54px;max-width:90px;padding:0 4px;font-size:10.5px}}"
    },
    {
      "name": "Settings navigation",
      "kind": "nav",
      "refersTo": "navigation-settings",
      "description": "Restored vertical tab rail. Runtime provides roving focus, activation, and linked panels.",
      "html": "<div class=\"ds-settings\" role=\"tablist\" aria-label=\"Settings sections\" aria-orientation=\"vertical\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Chart</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Markers</button></div>",
      "css": ".ds-settings{width:150px;padding:12px 0;border-right:1px solid var(--line,#e5e5e5);background:#fafafa}.ds-tab{font-family:Arial,Helvetica,sans-serif;display:block;width:100%;padding:11px 18px;text-align:left;border:0;border-left:3px solid transparent;background:transparent;color:#555;font-size:12px;cursor:pointer}.ds-tab:hover{background:#f0f0f0}.ds-tab[aria-selected=\"true\"]{background:#eaeaea;color:#111;border-left-color:#111;font-weight:600}.ds-tab:focus-visible{outline:2px solid var(--color-border-focus,#777777);outline-offset:2px}@media(max-width:540px){.ds-settings{width:94px}.ds-tab{padding:10px 8px;font-size:11px}}"
    },
    {
      "name": "Example badge",
      "kind": "chip",
      "refersTo": "badge-example",
      "description": "Informational synthetic-data badge in desktop metadata; hidden on phones.",
      "html": "<span class=\"ds-example\">EXAMPLE</span>",
      "css": ".ds-example{font-family:Arial,Helvetica,sans-serif;display:inline-block;padding:3px 5px;border-radius:3px;background:#f0f0f0;color:#696969;font-size:8px;letter-spacing:.8px}@media(max-width:640px){.ds-example{display:none}}"
    },
    {
      "name": "Floating legend",
      "kind": "card",
      "refersTo": "floating-legend",
      "description": "Population overlay preserves chart width. The blue marker represents scientific data, not UI branding.",
      "html": "<section class=\"ds-legend\" aria-label=\"Population legend\"><h2 class=\"ds-legend-title\">Populations</h2><button class=\"ds-legend-row\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"6\" r=\"3.5\" fill=\"#1f77b4\"/></svg><span class=\"ds-legend-name\">Group_A</span><span class=\"ds-legend-count\">60</span></button></section>",
      "css": ".ds-legend{font-family:Arial,Helvetica,sans-serif;width:202px;max-width:100%;border:1px solid #bcbcbc;border-left-color:var(--line,#e5e5e5);border-radius:2px;background:#fff;color:var(--color-text-primary,#363636)}.ds-legend-title{display:flex;align-items:center;height:30px;margin:0;padding:0 9px;font-size:11px;font-weight:600;color:#222}.ds-legend-row{font-family:Arial,Helvetica,sans-serif;display:flex;align-items:center;gap:5px;width:calc(100% - 8px);min-height:23px;margin:0 4px 5px;padding:3px 4px;border:0;border-radius:3px;background:transparent;color:inherit;font-size:12px;text-align:left;cursor:pointer}.ds-legend-row:hover{background:#f2f2f2}.ds-legend-row:focus-visible{outline:2px solid var(--color-border-focus,#777777);outline-offset:2px}.ds-legend-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-legend-count{color:#777;font-size:10px;font-variant-numeric:tabular-nums}@media(max-width:640px){.ds-legend{width:250px;max-height:48vh;overflow:auto;border:1px solid #aaa;border-radius:4px;background:rgba(252,252,252,.98);box-shadow:0 4px 20px rgba(0,0,0,.22)}}"
    }
  ],
  "narrative": {
    "northStar": "The Compact Research Viewer",
    "overview": "The owner selected commit `4dfd9238410fc9f22af9c5e05290460b1eba79e4` as the exact desktop and mobile visual authority. Black and grey chrome, Arial labels, fine rules, small controls, and a white full-width chart restore that implementation. This replaces the later forest/sage visual system and enlarged controls.\n\nThe interface is a dense scientific working surface. Population colors encode data; neutral interface colors communicate actions and state. Preserve the newer feature boundaries, scientific correctness, keyboard behavior, rendering, and export implementation while extending this restored visual system.",
    "keyCharacteristics": [
      "Compact Arial interface with a black brand tile and light grey header.",
      "Integrated toolbar with every desktop tool directly available.",
      "Full-width white chart and a floating population legend.",
      "Two-row mobile toolbar with horizontal tool scrolling."
    ],
    "rules": [
      {
        "name": "The Encoding Rule",
        "body": "Keep scientific population colors separate from interface tokens; preserve names, counts, marker shapes, visibility, and selection cues alongside color.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Use tabular figures for aligned coordinates and counts; preserve meaningful precision and identifiers.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** match the selected reference across desktop, phone, small, and landscape viewports.",
      "**Do** preserve the white full-width chart, integrated tools, floating legend, and original empty surface.",
      "**Do** retain truthful scientific state, palette geometry, tab semantics, focus ownership, and offline exports."
    ],
    "donts": [
      "**Don't** reintroduce forest/sage chrome, a permanent legend sidebar, an Appearance drawer, or enlarged controls.",
      "**Don't** recolor scientific populations to match interface chrome or conflate hidden, marked, selected, and excluded samples.",
      "**Don't** treat reference fidelity or passing focused checks as whole-app accessibility certification."
    ]
  }
}
